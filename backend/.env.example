PORT=3001
NODE_ENV=development

# 至少32位；生产环境必须使用随机密钥并由托管平台注入。
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE=2h

DB_HOST=127.0.0.1
DB_USER=xingban_app
DB_PASSWORD=replace-with-secret-manager-value
DB_NAME=xingban

# 本地无MySQL时可显式启用；生产环境禁止设置为true。
USE_MOCK_DB=false
ALLOW_MOCK_DB=false

# 多个来源用英文逗号分隔。正式前端默认来源如下。
CORS_ORIGINS=https://ranjohung.github.io,http://127.0.0.1:8001,http://localhost:8001

# 在单层反向代理后部署时设置为1，用于正确识别客户端IP和限流。
TRUST_PROXY=1

# 独立高熵密钥；服务会派生为AES-256-GCM密钥，不能与JWT密钥复用。
SENSITIVE_DATA_KEY=replace-with-a-separate-high-entropy-secret

# 仅本地演示短信使用；生产环境保持false并接入真实短信服务。
ENABLE_DEMO_SMS=false

# 可选AI回答；未配置时知识库使用可追溯的摘录模式。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
